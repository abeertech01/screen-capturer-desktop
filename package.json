{
  "name": "screen-capturer",
  "version": "1.0.0",
  "description": "A screen capturing app using Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --ext js,css,html --exec electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.aa.screencapturer",
    "productName": "Screen Capturer",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/camera.icns"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  }
}
